# Copy to .env.local (git-ignored) and fill in. .env also works.

# Server
PORT=3000
HOST=localhost

# Where in-progress / finished downloads are stored (auto-deleted after 1h)
# DOWNLOAD_DIR=./downloads

# Optional overrides. By default the app uses .venv/bin/yt-dlp and ./bin/ffmpeg (both created by `npm install`)
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# JS runtime for yt-dlp's YouTube challenge solver (auto-detected: deno, or Node 20+)
# JS_RUNTIME=node:/Users/you/.nvm/versions/node/v22.19.0/bin/node

# Google OAuth Web client ID for the dashboard sign-in (YouTube Data API v3).
# Create at https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=
