<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>YouTube Downloader · YoutubeUtilityManager</title>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <section class="hero">
      <p class="eyebrow">YouTube Downloader</p>
      <h1>Download any video in <span class="accent">full quality</span>.</h1>
      <p class="sub">Up to 8K/4K video with original streams, optional H.264 re-encode or compression, or audio-only in MP3, M4A, Opus, FLAC or WAV.</p>

      <form id="urlForm" class="url-form" autocomplete="off">
        <input id="url" type="text" inputmode="url" placeholder="Paste a YouTube link…" required>
        <button id="fetchBtn" class="btn primary" type="submit">Get options</button>
      </form>
      <p id="formError" class="error" hidden></p>
      <p id="depsWarning" class="warning" hidden></p>
    </section>

    <section id="result" class="card result" hidden>
      <div class="video-meta">
        <img id="thumb" alt="">
        <div>
          <h2 id="title"></h2>
          <p class="muted"><span id="channel"></span> · <span id="duration"></span></p>
        </div>
      </div>

      <div class="tabs" role="tablist">
        <button type="button" class="tab active" data-mode="video" role="tab">Video</button>
        <button type="button" class="tab" data-mode="audio" role="tab">Audio only</button>
      </div>

      <div id="videoOpts" class="opts">
        <label class="opt-label">Quality</label>
        <div id="qualities" class="chips"></div>

        <div class="row">
          <div class="field">
            <label class="opt-label" for="encoding">Encoding</label>
            <select id="encoding">
              <option value="original">Original streams — best quality, fastest</option>
              <option value="h264">H.264 / AAC — plays everywhere (re-encodes if needed)</option>
              <option value="compressed">Compressed — smaller file (H.264 CRF 28)</option>
            </select>
          </div>
          <div class="field">
            <label class="opt-label" for="container">Format</label>
            <select id="container">
              <option value="mp4">MP4</option>
              <option value="mkv">MKV</option>
              <option value="webm">WebM</option>
            </select>
          </div>
        </div>
        <p id="encodingHint" class="hint"></p>
      </div>

      <div id="audioOpts" class="opts" hidden>
        <label class="opt-label">Format</label>
        <div id="audioFormats" class="chips">
          <button type="button" class="chip active" data-value="mp3">MP3</button>
          <button type="button" class="chip" data-value="m4a">M4A (AAC)</button>
          <button type="button" class="chip" data-value="opus">Opus</button>
          <button type="button" class="chip" data-value="flac">FLAC</button>
          <button type="button" class="chip" data-value="wav">WAV</button>
          <button type="button" class="chip" data-value="best">Original (no conversion)</button>
        </div>
        <div class="field narrow">
          <label class="opt-label" for="bitrate">Bitrate</label>
          <select id="bitrate">
            <option value="320">320 kbps</option>
            <option value="256">256 kbps</option>
            <option value="192">192 kbps</option>
            <option value="128">128 kbps</option>
            <option value="96">96 kbps</option>
          </select>
        </div>
        <p id="audioHint" class="hint"></p>
      </div>

      <button id="downloadBtn" class="btn primary wide" type="button">Download</button>

      <div id="progress" class="progress" hidden>
        <div class="progress-top">
          <span id="stage">Starting…</span>
          <span id="pct">0%</span>
        </div>
        <div class="bar"><div id="barFill"></div></div>
        <div class="progress-bottom muted">
          <span id="speed"></span>
          <span id="eta"></span>
        </div>
        <div class="progress-actions">
          <button id="cancelBtn" class="btn ghost small" type="button">Cancel</button>
          <a id="saveBtn" class="btn primary small" hidden>Save file</a>
        </div>
      </div>
    </section>

    <section class="features">
      <div class="feature">
        <h3>Original quality</h3>
        <p>Grabs the highest-bitrate video and audio streams and merges them losslessly, with no recompression.</p>
      </div>
      <div class="feature">
        <h3>Every resolution</h3>
        <p>8K, 4K, 2K, 1080p, 720p, 480p and lower, depending on what the uploader published.</p>
      </div>
      <div class="feature">
        <h3>Creator tools</h3>
        <p>Sign in to the <a href="/dashboard">dashboard</a> to reply to comments in bulk on your own videos.</p>
      </div>
    </section>
  </main>

  <footer class="footer muted">Only download content you own or have permission to use.</footer>
  <script src="/js/downloader.js"></script>
</body>
</html>
